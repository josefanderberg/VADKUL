# VADKUL Scraper - Inställningar (EXEMPELMALL)

# Vilken databas vi läser/skriver till.
#   1 = PROD Firebase   (kostar reads/writes — använd sparsamt!)
#   2 = LOKAL emulator  (localhost:8080)  → starta med `npm run emulator:dev`
#   3 = TEST  emulator  (localhost:8081)  → starta med `npm run emulator:test`
DB_TARGET=2

# Facebook-inloggning (använd ett dedikerat bot-konto!)
FB_EMAIL=din_bot_email@gmail.com
FB_PASSWORD=ditt_bot_losenord

# Facebook Page (för publicering)
FB_PAGE_ID=ditt_page_id
FB_PAGE_TOKEN=din_facebook_page_token
