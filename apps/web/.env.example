# Firebase Client Config (Public keys prefixade med NEXT_PUBLIC_ för Next.js)
NEXT_PUBLIC_FIREBASE_API_KEY=ditt_firebase_api_key_har
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=vadkul-f2cb2.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vadkul-f2cb2
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=vadkul-f2cb2.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=ditt_messaging_sender_id_har
NEXT_PUBLIC_FIREBASE_APP_ID=ditt_app_id_har
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=ditt_measurement_id_har
NEXT_PUBLIC_FIREBASE_VAPID_KEY=ditt_fcm_vapid_key_har

# Hotjar Analytics (Frivillig)
NEXT_PUBLIC_HOTJAR_ID=6640410

# Stripe – event-boost (se docs/stripe-event-boost.md)
#
# INGET Stripe-värde behövs längre i webbappen. Priset ägs av Cloud-funktionen
# createBoostCheckout och står i apps/functions/.env.vadkul-f2cb2
# (STRIPE_BOOST_PRICE_ID) — klienten skickar bara vilket event som ska boostas.
#
# Kontot är VADKUL-kontot (acct_1U1AYAEfCOJn7thC). OBS: ett äldre pris
# (price_1U18WEAhkcTOmplPpOEyyguS) ligger på fel konto (makeamission) —
# använd ALDRIG det.
#
# TEST (skapad 5/8, prod_V1DgX2BJCe20pS "Boosta event – 7 dagar", 99 kr):
#   price_1U1BKkEfCOJn7thCSgZUzxNO
# LIVE: skapas efter kontoaktiveringen — fyll i i functions-env:en när den finns.

# Firebase Service Account (Endast för server-side operationer om det behövs)
# FIREBASE_SERVICE_ACCOUNT_KEY=

# Claude API — utkastgeneratorn i /admin/outreach (server-only!)
# ALDRIG NEXT_PUBLIC_-prefix på denna: nyckeln får inte nå webbläsaren.
# Dev: lägg den i .env.local. Deploy: lägg den i .env (gitignorad) —
# firebase deploy tar med .env-filerna till SSR-funktionen.
# Skapa nyckel på https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
