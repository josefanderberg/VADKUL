{
    "name": "functions",
    "scripts": {
        "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=lib/index.js --packages=external \"--alias:@vadkul/kontrakt=../../packages/kontrakt/src/index.ts\" --log-level=warning",
        "build:watch": "tsc --watch",
        "test": "vitest run",
        "serve": "npm run build && firebase emulators:start --only functions",
        "shell": "npm run build && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log"
    },
    "engines": {
        "node": "22"
    },
    "main": "lib/index.js",
    "dependencies": {
        "cheerio": "^1.0.0",
        "firebase-admin": "^14.5.0",
        "firebase-functions": "^7.4.0",
        "stripe": "^22.4.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "esbuild": "^0.28.2",
        "typescript": "^5.0.0",
        "vitest": "^5.0.4"
    },
    "private": true
}
