# Miljövariabler för Cloud Functions i projektet vadkul-f2cb2.
# Läses av firebase-functions vid deploy (per-projekt-filen, INTE .env — den
# är gitignorerad och följer alltså inte med när Mac minin deployar från main).
# Bara icke-hemligheter här. Stripes secret key ligger i Secret Manager:
#   firebase functions:secrets:set STRIPE_API_KEY

# Stripe Price-ID för event-boosten (7 dagar). Ägs av backend — klienten
# skickar aldrig något pris. Byts vid live/test-växling.
STRIPE_BOOST_PRICE_ID=price_1U1BKkEfCOJn7thCSgZUzxNO

# Boost i tre nivåer (tier: day/week/month i createBoostCheckout). Ett
# One-time-pris per nivå skapas i Stripe Dashboard → Products (SEK, engångs);
# klistra in respektive Price-ID nedan. _WEEK får utelämnas — då används
# STRIPE_BOOST_PRICE_ID ovan (7-dagarspriset), så dagens beteende är orört.
# Saknas priset för en nivå svarar createBoostCheckout "Boost är inte
# tillgängligt ännu" för just den nivån; övriga nivåer fungerar ändå.
# STRIPE_BOOST_PRICE_ID_DAY=price_XXXXXXXXXXXX
# STRIPE_BOOST_PRICE_ID_MONTH=price_XXXXXXXXXXXX
