{
  "name": "vadkul-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "node apps/scraper/scripts/print-alerts.mjs",
    "dev": "npm run dev -w web",
    "alerts": "node apps/scraper/scripts/print-alerts.mjs --all",
    "dev:reset": "bash scripts/dev-reset.sh",
    "dev:check": "bash scripts/dev-reset.sh --check",
    "build": "npm run build -w web",
    "start": "npm run start -w web",
    "lint": "npm run lint -w web",
    "dashboard": "npm run dashboard -w vadkul-scraper",
    "create-event": "npm run create -w vadkul-scraper",
    "today": "npm run today -w vadkul-scraper",
    "scrape": "npm run start -w vadkul-scraper"
  },
  "dependencies": {
    "next": "^15.5.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
