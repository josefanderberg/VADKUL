<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>se.vadkul.audit-pending</string>

    <!-- Kör daemonen via login-shell så node/npx finns på PATH.
         OBS: justera sökvägen om repot ligger någon annanstans. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd /Users/ai/Repos/VADKUL/apps/scraper &amp;&amp; exec npm run audit-daemon</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ai/Repos/VADKUL/apps/scraper</string>

    <!-- Starta vid inloggning och starta om om processen dör. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Strypa omstartsfrekvensen så vi inte spammar vid kraschloop. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/ai/Library/Logs/vadkul-audit-pending.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ai/Library/Logs/vadkul-audit-pending.err.log</string>
</dict>
</plist>
