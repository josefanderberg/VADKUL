rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HJÄLPFUNKTIONER ---
    
    // Är man inloggad?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Är man ägare till datat? (t.ex. sin egen profil)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Är man Admin? (Kräver att du sätter fältet 'isAdmin: true' på din user i Firestore)
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Är man värd för eventet? (Fältet 'host.uid' måste matcha)
    function isHost() {
       return isAuthenticated() && resource.data.host.uid == request.auth.uid;
    }

    // --- REGLER PER KOLLEKTION ---

    // 1. USERS
    match /users/{userId} {
      allow read: if true; // Behövs för att se andras profiler/bilder (även om man inte är inloggad)
      allow create: if isOwner(userId); // Man får skapa sin egen profil
      
      // Man får uppdatera sin egen profil...
      // ELLER om man bara uppdaterar 'rating' och 'ratingCount' (för att ge omdöme)
      allow update: if isOwner(userId) 
        && (
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified']) || request.resource.data.isVerified == false)
          &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus']) || request.resource.data.verificationStatus in ['pending', 'none'])
        )
        || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratingCount']));
        
      // Man får radera sitt eget users-dokument (kontoradering/GDPR) —
      // Auth-kontot raderas i appen, det här släpper igenom dokumentet.
      allow delete: if isOwner(userId);

      // Admins får göra allt (t.ex. verifiera användare)
      allow write: if isAdmin();
      
      // UNDERSAMLING: Reviews (Omdömen)
      match /reviews/{reviewerId} {
        // Man får läsa alla omdömen (eller begränsa om man vill)
        allow read: if isAuthenticated();
        // Man får skriva ETT omdöme om man är den personen (reviewerId måste matcha mitt UID)
        allow write: if isAuthenticated() && request.auth.uid == reviewerId;
      }

      // UNDERSAMLING: Friends (Vänner)
      match /friends/{friendId} {
        allow read: if isAuthenticated();
        // Tillåt skrivning om:
        // 1. Man är ägare till profilen (userId == auth.uid) - Jag hanterar min och andras status hos mig
        // 2. Man är vännen som läggs till (friendId == auth.uid) - Jag lägger till mig själv som 'incoming' hos dig
        allow write: if isAuthenticated() && (request.auth.uid == userId || request.auth.uid == friendId);
      }
    }

    // 2. EVENTS
    match /events/{eventId} {
      allow read: if true; // Alla kan se events (eller ändra till isAuthenticated() om du vill ha det privat)
      
      allow create: if isAuthenticated(); // Bara inloggade får skapa
      
      allow delete: if isHost() || isAdmin(); // Bara värden eller admin får ta bort

      allow update: if 
        isAdmin() ||            // Admin får ändra allt
        isHost() ||             // Värden får ändra allt
         (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees'])) ||
         // Tillåt alla (även oinloggade) att öka visningar
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);

      // UNDERSAMLING: Event Chat Messages
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
      }
    }
    
    // 3. CHATS (Privata meddelanden / Grupper)
    match /chats/{chatId} {
      // READ: Tillåt om man är med i arrayen (resursen måste finnas)
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants);

      // CREATE: Tillåt om man lägger till sig själv i arrayen (resursen finns inte än -> kolla request)
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participants);

      // UPDATE: Tillåt om man REDAN är med (kolla resource)
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      
      // Undersamling: Messages
      match /messages/{messageId} {
        // Man får läsa meddelanden om man får läsa chatten (parent)
        allow read: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        // Man får skriva om man är deltagare
        allow create: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
      }
    }
    
    // 4. NOTIFICATIONS (Om du använder det)
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      // Man får skapa notiser, men bara MED SIG SJÄLV som avsändare (anti-spoof/spam).
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.recipientId == request.auth.uid; // TILLÅT uppdatering (markera som läst)
    }
    
    // 5. FEEDBACK
    match /feedback/{feedbackId} {
        // Anonym feedback tillåts (medvetet), men begränsa form + storlek mot spam/abuse.
        allow create: if request.resource.data.keys().hasOnly(['rating', 'message', 'createdAt', 'userAgent', 'userId'])
          && request.resource.data.keys().hasAll(['rating', 'message', 'createdAt'])
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.message is string
          && request.resource.data.message.size() < 2000;
        allow read: if isAdmin();
    }

    // 6. REPORTS (Rapportering av events)
    match /reports/{reportId} {
        allow create: if isAuthenticated();
        allow read, update, delete: if isAdmin();
    }

    // 6b. WAITLIST ("ställ dig i kö" för funktioner som inte byggts än)
    // Anonym create tillåts (man kan stå i kö utan konto), men shape-begränsad.
    match /waitlist/{docId} {
        allow create: if request.resource.data.keys().hasOnly(['featureId', 'uid', 'email', 'createdAt'])
          && request.resource.data.keys().hasAll(['featureId', 'createdAt'])
          && request.resource.data.featureId is string
          && request.resource.data.featureId.size() < 100;
        allow read, update, delete: if isAdmin();
    }

    // 7. PUBLIC SETTINGS
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. LINK EVENTS
    match /linkEvents/{eventId} {
      // Alla kan läsa
      allow read: if true;

      // Inloggade får skapa EGNA event — hårt formbegränsade så de inte kan
      // låtsas vara scrapade event eller skriva godtyckliga fält.
      allow create: if isAuthenticated()
        && request.resource.data.userCreated == true
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.status == 'published'
        && request.resource.data.keys().hasOnly([
            'title', 'time', 'lat', 'lng', 'locationName', 'category', 'emoji',
            'hostName', 'hostUid', 'userCreated', 'status', 'hidden', 'url',
            'description', 'createdAt', 'isLocationVerified'
        ]);

      // Uppdatera/radera: bara sitt eget användarskapade event…
      allow update, delete: if isAuthenticated()
        && resource.data.userCreated == true
        && resource.data.hostUid == request.auth.uid;

      // …eller admin (scrapade event förblir admin-only).
      allow create, update, delete: if isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // 8b. EVENT-CHATT (per kart-event, nyckeln är URL-enkodat event-id).
    // Läsning öppen (chatten syns för alla) — skrivning kräver konto och
    // formbegränsas mot spam/spoofing (senderId måste vara ens eget uid).
    match /eventChats/{chatId}/messages/{messageId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'senderImage', 'text', 'createdAt'
        ]);
    }

    // 9. FCM TOKENS
    match /fcmTokens/{userId} {
      match /tokens/{token} {
        allow read, write: if isOwner(userId);
      }
    }

    // 10. AGGREGATED EVENTS (Progressive event layers)
    match /aggregatedEvents/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. PRESENCE (Realtids-GPS för inloggade användare)
    // Varje user skriver bara sin egen rad; alla inloggade kan läsa.
    match /presence/{userId} {
      allow read:   if isAuthenticated();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['lat', 'lng', 'displayName', 'photoURL', 'updatedAt', 'isVisible'])
        && request.resource.data.lat  is number
        && request.resource.data.lng  is number
        && request.resource.data.isVisible is bool;
      allow update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['lat', 'lng', 'displayName', 'photoURL', 'updatedAt', 'isVisible'])
        && request.resource.data.lat  is number
        && request.resource.data.lng  is number
        && request.resource.data.isVisible is bool;
      allow delete: if isOwner(userId);
    }
  }
}